    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/validator": "^13.15.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
