    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.x"
  },
  "scripts": {
    "dev": "nodemon",
    "dev:realtime": "cross-env ENABLE_INGESTOR=true ENABLE_STOPOUT=true STAKING_CRONS=false nodemon --config nodemon.worker.json",
    "dev:cron": "cross-env ENABLE_INGESTOR=false ENABLE_STOPOUT=false STAKING_CRONS=true nodemon --config nodemon.worker.json",
    "dev:all": "concurrently -n WEB,REALTIME,CRON -c green,cyan,magenta \"yarn dev\" \"yarn dev:realtime\" \"yarn dev:cron\"",
    "build": "tsc",
    "postbuild": "tsc-alias",
    "start": "node dist/server.js",
    "realtime": "node --optimize_for_size --max_old_space_size=800 dist/workers/boot.js",
    "cron": "node --optimize_for_size --max_old_space_size=256 dist/workers/boot.js",
    "heroku-postbuild": "npm run build && npm run postbuild"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
